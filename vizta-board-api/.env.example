# ── Django ────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production-use-50-random-chars
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgres://vizta:password@localhost:5432/vizta_board

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Clerk ─────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://your-clerk-frontend-api.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_...

# ── AWS ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=vizta-board-media
AWS_CLOUDFRONT_DOMAIN=your-id.cloudfront.net
AWS_SES_FROM_EMAIL=noreply@viztaboard.com
AWS_SNS_REGION=us-east-1

# ── Stripe ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Expo Push ─────────────────────────────────────────
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── CORS ──────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Celery ────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1

# ── Security ──────────────────────────────────────────
FIELD_ENCRYPTION_KEY=32-byte-key-for-bank-details-encryption
